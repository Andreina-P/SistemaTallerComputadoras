# Copia este archivo como .env y cambia los valores. NUNCA subas el .env real al repositorio.

# Aplicación
NODE_ENV=development
PORT=3000
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Dirección con la que se abre la aplicación (va en los enlaces de los correos)
APP_URL=http://localhost:3000

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reparus
DB_USER=reparus
DB_PASSWORD=cambia_esta_clave
# Puerto con el que se ve la base de datos desde tu computador cuando usas Docker
DB_PORT_EXTERNAL=5433

# Correo simulado (Mailpit). La bandeja se ve en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Reparus Tec <no-responder@reparus.test>"
