{
  "name": "reparus-tec",
  "version": "1.0.0",
  "description": "Reparus Tec: sistema de gestión de órdenes de reparación de computadoras (monolito del 1er bimestre)",
  "private": true,
  "main": "src/servidor.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "nodemon src/servidor.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "jest",
    "format": "prettier --write ."
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/pruebas/**/*.test.js"
    ]
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.9",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
