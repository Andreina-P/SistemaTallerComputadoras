<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <% if (!token) { %>
      <h1 class="h3 mb-3">Enlace no válido</h1>
      <p>El enlace ya se usó, venció o no es correcto. Pide uno nuevo para continuar.</p>
      <a class="btn btn-primary" href="/recuperar">Pedir otro enlace</a>
    <% } else { %>
      <h1 class="h3 mb-3">Elige tu clave nueva</h1>

      <form method="post" action="/restablecer" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <input type="hidden" name="token" value="<%= token %>">

        <%- include('../parciales/campo', {
          name: 'password', label: 'Clave nueva', type: 'password', errors,
          atributos: 'required minlength="8" maxlength="72" pattern="(?=.*[A-Za-z])(?=.*\\d).{8,72}" autocomplete="new-password"',
          mensaje: 'Mínimo 8 caracteres, con al menos una letra y un número.'
        }) %>

        <button type="submit" class="btn btn-primary w-100">Cambiar clave</button>
      </form>
    <% } %>
  </div>
</div>
