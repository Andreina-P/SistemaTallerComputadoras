<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <h1 class="h3 mb-3">Mi perfil</h1>

    <div class="card mb-3">
      <div class="card-body">
        <h2 class="h6">Datos de la cuenta</h2>
        <p class="mb-1">Correo: <%= profile.email %> <span class="text-secondary">(no se puede cambiar)</span></p>
        <p class="mb-0">Cédula: <%= profile.nationalId %> <span class="text-secondary">(no se puede cambiar)</span></p>
      </div>
    </div>

    <form method="post" action="/perfil" class="needs-validation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

      <%- include('../parciales/campo', {
        name: 'name', label: 'Nombre completo', value: values.name, errors,
        atributos: 'required minlength="3" maxlength="80" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ ]+" autocomplete="name"',
        mensaje: 'Usa de 3 a 80 caracteres, solo letras y espacios.'
      }) %>
      <%- include('../parciales/campo', {
        name: 'phone', label: 'Teléfono', type: 'tel', value: values.phone, errors,
        atributos: 'required inputmode="numeric" maxlength="10" pattern="\\d{10}" autocomplete="tel"',
        mensaje: 'El teléfono debe tener 10 dígitos, solo números.'
      }) %>
      <%- include('../parciales/campo', {
        name: 'address', label: 'Dirección (opcional)', value: values.address, errors,
        atributos: 'maxlength="150" autocomplete="street-address"',
        mensaje: 'La dirección admite máximo 150 caracteres.'
      }) %>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-outline-secondary" href="/ordenes">Cancelar</a>
      </div>
    </form>
  </div>
</div>

