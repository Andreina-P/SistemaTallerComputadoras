<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.titulo ? titulo + ' · ' : '' %>Reparus Tec</title>
  <link rel="icon" type="image/svg+xml" href="/img/logo-icono.svg">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/poppins/400.css">
  <link rel="stylesheet" href="/vendor/poppins/600.css">
  <link rel="stylesheet" href="/vendor/poppins/800.css">
  <link rel="stylesheet" href="/css/tema.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('parciales/menu') %>

  <main class="container py-4 flex-grow-1">
    <%- include('parciales/mensajes') %>
    <%- body %>
  </main>

  <%- include('parciales/pie') %>

  <% if (locals.currentUser) { %>
    <div id="avisos" class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite" aria-atomic="true"></div>
  <% } %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/validacion-formularios.js"></script>
  <% if (locals.currentUser) { %>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/tiempo-real.js"></script>
    <script src="/js/avisos.js"></script>
  <% } %>
</body>
</html>
